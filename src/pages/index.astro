---
// Content lives here: a role, date or skill change is a one-line edit.
type Role = {
  start: string; // YYYY-MM
  end?: string; // YYYY-MM; omitted means current
  company: string;
  via?: string; // contracting company, when the client is the employer of record
  title: string;
  concurrent?: boolean; // overlaps another role (contract work)
  points: string[];
  stack: string;
};

const roles: Role[] = [
  {
    start: '2025-11', company: 'Pinterest', via: 'BairesDev', title: 'Senior Backend Engineer', concurrent: true,
    points: [
      'Pipelines that migrate service and owner SPIFFE IDs and their Knox keys to a new identity format, so workloads keep the right access',
      'AI-assisted automation in the migration workflow',
    ],
    stack: 'go, spiffe, knox',
  },
  {
    start: '2024-03', company: 'PlayOnSports', via: 'Nortal', title: 'Senior Full Stack Engineer', concurrent: true,
    points: ['Event creation, fundraising and live sports streaming features, with U.S. product and engineering teams'],
    stack: 'ruby, go, react, postgresql, mongodb, redis, aws, kubernetes',
  },
  {
    start: '2025-11', end: '2026-02', company: 'Flexera', via: 'Catalyte', title: 'Senior Full Stack Engineer', concurrent: true,
    points: ['Cloud cost-optimization analytics: savings-calculation logic, SQL models and data-quality checks'],
    stack: 'sql, data modeling',
  },
  {
    start: '2024-04', end: '2025-04', company: 'Shipt', via: 'Pyramid Consulting', title: 'Senior Backend Engineer', concurrent: true,
    points: ['Migrated and optimized backend services, deployed and operated on AWS and GCP'],
    stack: 'go, rails, kafka, redis, docker, kubernetes',
  },
  {
    start: '2021-11', end: '2024-03', company: 'Hapi', title: 'Senior Software Developer',
    points: ['Backends for stock and crypto trading platforms', 'Owned delivery: CI/CD, releases, monitoring and infrastructure automation'],
    stack: 'nestjs, go, postgresql, mongodb, kafka, aws, argo cd, terraform, ansible, grafana',
  },
  {
    start: '2021-04', end: '2023-12', company: 'Mercado Libre', title: 'Software Development Sr. Analyst', concurrent: true,
    points: ['Distributed post-sale systems for the customer experience at scale'],
    stack: 'go, rails, react, spring, redis, docker, gcp, aws',
  },
];

const earlier = [
  { company: 'Rankmi', what: 'HR platform', years: '2020–2021' },
  { company: 'Picap', what: 'transportation', years: '2019–2020' },
  { company: 'Append', what: 'National Registry Office systems', years: '2018–2019' },
];

const projects = [
  {
    name: 'rock-paper-scissors-lizard-spock/',
    repo: 'https://github.com/mcameloa/rock-paper-scissors-lizard-spock',
    live: 'https://mcameloa.github.io/rock-paper-scissors-lizard-spock/',
    text: 'The five-option game against the computer: keyboard playable, accessible, responsive, tested and deployed by CI.',
    stack: 'react, typescript, tailwind css, vitest, github actions',
  },
];

const skills: [string, string][] = [
  ['languages', 'go, ruby, typescript, java'],
  ['frameworks', 'rails, nestjs, react, spring boot'],
  ['data', 'postgresql, mongodb, redis, kafka, sqs'],
  ['infra', 'aws, gcp, docker, kubernetes, argo cd, terraform, ansible, grafana'],
];

const period = (r: Role) => `${r.start} → ${r.end ?? 'now'}`;
const description = 'Senior software engineer: backend systems in Go and Ruby on Rails, on Kubernetes, AWS and GCP.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Milton Camelo — Senior Software Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Milton Camelo" />
  <link rel="canonical" href="https://mcameloa.github.io/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content="Milton Camelo — Senior Software Engineer" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://mcameloa.github.io/" />
  <meta property="og:image" content="https://mcameloa.github.io/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --bg: #fafaf7;
      --ink: #1a1a18;
      --muted: #5c5c55;
      --rule: #c9c9c0;
      --link: #2f6b3a;
      --link-hover: #1d4826;
      --label: 190px;
      color-scheme: light;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #161614;
        --ink: #e8e8e2;
        --muted: #a3a39a;
        --rule: #3a3a35;
        --link: #8cc995;
        --link-hover: #b3e0b9;
        color-scheme: dark;
      }
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 15px;
      line-height: 1.65;
    }
    a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
    a:hover { color: var(--link-hover); }
    :focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
    h1, h2, h3, p, ul { margin: 0; }

    main { max-width: 860px; margin: 0 auto; padding: 80px 24px 96px; display: flex; flex-direction: column; gap: 56px; }
    section { display: flex; flex-direction: column; gap: 14px; }
    h2 { font-size: 18px; font-weight: 600; }
    .muted { color: var(--muted); }
    .prompt { color: var(--muted); }
    h1 { font-size: 40px; font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; }
    .lead { font-size: 17px; }
    .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 6px; }
    .about { max-width: 72ch; }

    .row { display: grid; grid-template-columns: var(--label) minmax(0, 1fr); gap: 4px 20px; }
    .role { border-top: 1px dashed var(--rule); padding-top: 16px; }
    .role h3, .project h3 { font-size: 16px; font-weight: 600; }
    .role .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 14px; }
    .tag { color: var(--link); }
    .points { list-style: none; padding: 0; }
    .points li { padding-left: 2ch; text-indent: -2ch; }
    .points li::before { content: '- '; }
    .stack { font-size: 13px; }
    .date { font-size: 14px; }
    .kv { gap: 6px 20px; }

    footer { border-top: 1px dashed var(--rule); padding-top: 16px; font-size: 13px; }

    @media (max-width: 640px) {
      main { padding: 48px 16px 64px; gap: 44px; }
      h1 { font-size: 30px; }
      .row { grid-template-columns: minmax(0, 1fr); }
      .kv dt { margin-top: 6px; }
    }

    @media print {
      :root { --bg: #fff; --ink: #000; --muted: #444; --link: #000; }
      body { font-size: 11pt; }
      main { padding: 0; gap: 24px; max-width: none; }
      a { text-decoration: none; }
      .links a[href^='http']::after, .links a[href^='mailto']::after { content: ' (' attr(href) ')'; font-size: 9pt; }
      .role { break-inside: avoid; }
      footer { display: none; }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <p class="prompt" aria-hidden="true">~/mcameloa $ cat README.md</p>
      <h1><span aria-hidden="true"># </span>Milton Camelo</h1>
      <p class="lead">Senior software engineer — backend, Go and Ruby on Rails, Kubernetes.</p>
      <p class="muted">location: Armenia, Colombia (remote, U.S. teams since 2021)<br />languages: es (native), en (C1)</p>
      <nav class="links" aria-label="Contact">
        <a href="mailto:javicameloa@gmail.com">mail</a>
        <a href="https://www.linkedin.com/in/mcameloa/">linkedin</a>
        <a href="https://github.com/mcameloa">github</a>
      </nav>
    </header>

    <section aria-labelledby="about">
      <h2 id="about">## about</h2>
      <p class="about">Eight years building production platforms: microservices, Kafka pipelines, PostgreSQL and Redis on AWS and GCP. Owned CI/CD and infrastructure (Argo CD, Terraform, Ansible, Grafana). Lately: service identity and access migrations with SPIFFE and Knox.</p>
      <p class="about muted">At home I run a small K3s cluster managed with GitOps (Argo CD, OpenBao, Prometheus) to try out infrastructure and AI-agent workflows.</p>
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience">## experience</h2>
      {roles.map((r) => (
        <article class="row role">
          <p class="muted date">{period(r)}</p>
          <div>
            <h3>{r.company}{r.via && <span class="muted" style="font-weight: 400"> (via {r.via})</span>}</h3>
            <p class="meta">
              <span>{r.title}</span>
              {r.concurrent && <span class="tag">[concurrent contract]</span>}
            </p>
            <ul class="points">
              {r.points.map((p) => <li>{p}</li>)}
            </ul>
            <p class="muted stack">stack: {r.stack}</p>
          </div>
        </article>
      ))}
      <div class="row role">
        <p class="muted date">2018 → 2021</p>
        <p>earlier: {earlier.map((e, i) => <>{i > 0 && ' · '}{e.company} <span class="muted">({e.what})</span></>)}</p>
      </div>
    </section>

    <section aria-labelledby="projects">
      <h2 id="projects">## projects</h2>
      {projects.map((p) => (
        <article class="row project">
          <h3>{p.name}</h3>
          <div>
            <p>{p.text}</p>
            <p class="muted stack">stack: {p.stack}</p>
            <p class="links"><a href={p.live}>play it</a><a href={p.repo}>source</a></p>
          </div>
        </article>
      ))}
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills">## skills</h2>
      <dl class="row kv">
        {skills.map(([k, v]) => <><dt class="muted">{k}</dt><dd style="margin: 0">{v}</dd></>)}
      </dl>
    </section>

    <section aria-labelledby="education">
      <h2 id="education">## education</h2>
      <p>software engineering — politécnico grancolombiano (2025 → present)</p>
      <p class="muted">google cloud: core infrastructure (2020) · infrastructure foundation (2020) · core services (2021)</p>
    </section>

    <footer class="muted">built with astro · <a href="https://github.com/mcameloa/mcameloa.github.io">source</a></footer>
  </main>
</body>
</html>
